# Staging-only template. Copy to .env on the staging VPS and replace every CHANGE_ME value.
# Never copy production credentials, database URLs, or volume data into this file.
COMPOSE_PROJECT_NAME=linuxunity-staging
SITE_ENVIRONMENT=staging
SERIES_PREVIEW_ENABLED=true

SITE_DOMAIN=dev.linuxunity.com
SITE_WWW_DOMAIN=www.dev.linuxunity.com
PROJECT_DOMAIN=project-dev.linuxunity.com
KUMA_DOMAIN=kuma-dev.linuxunity.com
NGINX_HTTP_BIND=0.0.0.0:80
NGINX_HTTPS_BIND=0.0.0.0:443
NGINX_DIAGNOSTIC_BIND=127.0.0.1:8080

APP_IMAGE=000000000000.dkr.ecr.ap-southeast-1.amazonaws.com/cloud-devops-blog:CHANGE_ME_GIT_SHA
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ECR_REGISTRY=000000000000.dkr.ecr.ap-southeast-1.amazonaws.com
AWS_ECR_REPOSITORY=cloud-devops-blog

POSTGRES_DB=payload_staging
POSTGRES_USER=payload_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
PAYLOAD_SECRET=CHANGE_ME_STAGING_PAYLOAD_SECRET
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=linuxunity:staging

GITHUB_CLIENT_ID=CHANGE_ME_STAGING_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=CHANGE_ME_STAGING_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=https://dev.linuxunity.com/api/auth/github/callback
GOOGLE_CLIENT_ID=CHANGE_ME_STAGING_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_STAGING_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://dev.linuxunity.com/api/auth/google/callback

# Use staging-only mail credentials, or leave SMTP disabled while testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LinuxUnity Staging <no-reply@dev.linuxunity.com>

# Keep backups outside the production backup tree.
BACKUP_ROOT=./backups-staging
BACKUP_RETENTION_DAYS=14
