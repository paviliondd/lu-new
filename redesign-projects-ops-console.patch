+// Filters map to real project fields: AWS / Kubernetes / DevOps match the
+// category (or a tag), Lab matches type, Production matches completed status.
+const requestedFilters = ["All", "AWS", "Kubernetes", "DevOps", "Lab", "Production"] as const;
+type Filter = (typeof requestedFilters)[number];
+
+function matchesFilter(project: Project, filter: Filter): boolean {
+  if (filter === "All") return true;
+  if (filter === "Lab") return project.type === "Lab";
+  if (filter === "Production") return project.status === "completed";
+  return project.category === filter || project.tags.includes(filter);
+}
+
+const statusLabels = { completed: "Completed", "in-progress": "In progress", archived: "Archived" } as const;
 
